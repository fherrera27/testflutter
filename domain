4.1 LoadOfferUseCase

final class LoadOfferUseCase {

    private let repository: CardUpgradeRepository

    init(repository: CardUpgradeRepository) {
        self.repository = repository
    }

    func execute(request: [String: Any]) async throws -> OfferModel {
        try await repository.loadOffer(request: request)
    }
}

Simple. No hay lógica.

⸻

4.2 ContinueUseCase (Aquí está lo importante)

Este es el núcleo del flujo 200 / 412.

final class ContinueUpgradeUseCase {

    private let repository: CardUpgradeRepository

    init(repository: CardUpgradeRepository) {
        self.repository = repository
    }

    func execute(
        request: [String: Any],
        flowMode: UpgradeFlowMode
    ) async -> ContinueResult {

        do {
            let operationId = try await repository.validateLimits(request: request)
            return .proceed(operationId: operationId)

        } catch let error as RepositoryError {

            if case .http(let status, _) = error, status == 412 {

                // REGLA DURA DEL NEGOCIO
                if flowMode == .withLimit {
                    return .requiresSwitchToNoLimit
                } else {
                    return .failure
                }
            }

            return .failure

        } catch {
            return .failure
        }
    }
}

🔥 Aquí está la regla:
	•	412 + withLimit → pedir cambio a noLimit
	•	412 + noLimit → error genérico
	•	otros → error

Esto es negocio.
No es UI.
No es Data.


5.3 Mapper (DTO → Domain) sin inventar strings

// Data/Mappers/OfferModelMapper.swift
import Foundation

struct OfferModelMapper {

  private let cardMapper: CardModelMapper
  private let creditLimitMapper: CreditLimitMapper

  init(cardMapper: CardModelMapper, creditLimitMapper: CreditLimitMapper) {
    self.cardMapper = cardMapper
    self.creditLimitMapper = creditLimitMapper
  }

  func map(_ dto: GetOfferResponseDTO) throws -> OfferModel {
    guard
      let data = dto.data,
      let offer = data.offer,
      let identification = offer.identification,
      let details = offer.details
    else { throw RepositoryError.decoding }

    let idModel = OfferIdentification(
      evaluationId: identification.evaluationId ?? "",
      operationId: identification.operationId,
      maskedCardNumber: identification.maskedCardNumber
    )

    let current = try cardMapper.map(details.current, fallbackId: "current")
    let offered = try normalizeOffered(details.offered)
      .enumerated()
      .map { idx, cardDto in try cardMapper.map(cardDto, fallbackId: "offered_\(idx)") }

    let detailsModel = OfferDetails(current: current, offered: offered)

    let creditLimit = creditLimitMapper.map(offer.creditLimit)

    return OfferModel(
      identification: idModel,
      details: detailsModel,
      creditLimit: creditLimit
    )
  }

  // Ajusta según tu tipo real; aquí lo hago genérico.
  private func normalizeOffered(_ offered: OfferedDTOContainer) -> [CardProductDTO] {
    switch offered {
    case .array(let arr): return arr
    case .dictionary(let dict): return dict.values.map { $0 }
    case .single(let one): return [one]
    }
  }
}



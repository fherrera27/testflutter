5.1 Errores neutros (Data)

// Data/Remote/RepositoryError.swift
import Foundation

enum RepositoryError: Error, Equatable {
  case http(status: Int, message: String?)
  case decoding
  case transport(String)
  case unknown
}

protocol HTTPStatusCodeProviding: Error { var statusCode: Int { get } }
protocol HTTPMessageProviding: Error { var message: String? { get } }

struct RepositoryErrorMapper {
  func map(_ error: Error) -> RepositoryError {
    if let e = error as? HTTPStatusCodeProviding {
      let msg = (error as? HTTPMessageProviding)?.message
      return .http(status: e.statusCode, message: msg)
    }
    // agrega casos según tu client generado
    return .unknown
  }
}



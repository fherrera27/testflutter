  func getOfferModel(request: [String: Any]) async throws -> OfferModel {
    do {
      let dto = try await api.getOffer(request: request)
      return try mapper.map(dto)
    } catch {
      throw errorMapper.map(error)
    }
  }

  func validateLimits(request: [String: Any]) async throws -> ValidateLimitsResponseDTO {
    do {
      return try await api.validateLimits(request: request)
    } catch {
      // NO decides 412 => modal. Solo propagas status.
      throw errorMapper.map(error)
    }

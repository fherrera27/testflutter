5.4 Card mapper: beneficios/rates como arrays, value tipado

// Data/Mappers/CardModelMapper.swift
import Foundation

struct CardModelMapper {

  func map(_ dto: CardProductDTO, fallbackId: String) throws -> CardModel {
    let id = dto.bulletCode ?? dto.cardId ?? fallbackId

    let benefits = mapBenefits(dto.benefits)
    let rates = mapRates(dto.cardRates)

    return CardModel(
      id: id,
      benefits: benefits,
      rates: rates,
      cardArtBase64: dto.cardArt
    )
  }

  private func mapBenefits(_ dict: [String: BenefitDTO]?) -> [BenefitModel] {
    guard let dict else { return [] }
    return dict.map { key, value in
      BenefitModel(id: key, title: value.title, value: value.value)
    }
    // orden si el dominio lo requiere, pero idealmente lo decide Presenter o Policy
  }

  private func mapRates(_ dict: [String: FeeDTO]?) -> [RateModel] {
    guard let dict else { return [] }
    return dict.map { key, fee in
      RateModel(id: key, title: fee.title, value: mapRateValue(fee))
    }
  }

  private func mapRateValue(_ fee: FeeDTO) -> RateValueModel {
    if let s = fee.valuePerTransaction, !s.isEmpty { return .perTransaction(s) }
    if let p = fee.percentage { return .percentage(Decimal(p)) }
    if let a = fee.amount, let c = fee.currency { return .amount(Decimal(a), currency: c) }
    return .unknown
  }
}

Fíjate: sin strings tipo “—”, sin formatear, sin “UF”, sin “CLP”.
Sólo “valor tipado” para que Presenter/View decidan cómo mostrarlo.


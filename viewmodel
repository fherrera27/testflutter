🚀 5️⃣ ViewModel completo

// Presentation/ViewModel/CardUpgradeViewModel.swift

import Foundation

@MainActor
final class CardUpgradeViewModel: ObservableObject {

    // MARK: - Published

    @Published private(set) var viewData: CardUpgradeViewData

    // MARK: - Dependencies

    private let loadUseCase: LoadOfferUseCase
    private let continueUseCase: ContinueUpgradeUseCase
    private let requestBuilder: ContinueRequestBuilder
    private let presenter: CardUpgradePresenter

    // MARK: - Internal State

    private var state = CardUpgradeScreenState()

    private var loadTask: Task<Void, Never>?
    private var actionTask: Task<Void, Never>?

    // MARK: - Init

    init(
        loadUseCase: LoadOfferUseCase,
        continueUseCase: ContinueUpgradeUseCase,
        requestBuilder: ContinueRequestBuilder,
        presenter: CardUpgradePresenter
    ) {
        self.loadUseCase = loadUseCase
        self.continueUseCase = continueUseCase
        self.requestBuilder = requestBuilder
        self.presenter = presenter

        self.viewData = presenter.build(from: state)
    }
}



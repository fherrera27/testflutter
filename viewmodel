▶️ 9️⃣ Tap Continue (orquestación limpia)

func tapContinue() {

    guard
        let snapshot = state.snapshot,
        let selectedId = state.selectedCardId
    else { return }

    actionTask?.cancel()

    actionTask = Task {

        update { $0.actionPhase = .loading }

        let request = requestBuilder.build(
            evaluationId: snapshot.identification.evaluationId,
            selectedCardId: selectedId,
            flowMode: state.flowMode
        )

        let result = await continueUseCase.execute(
            request: request,
            flowMode: state.flowMode
        )

        handleContinueResult(result)
    }
}


⸻

🧠 10️⃣ Interpretación del resultado (NO negocio, solo orquestación)

private func handleContinueResult(_ result: ContinueResult) {

    switch result {

    case .proceed(let operationId):
        update {
            $0.actionPhase = .idle
            $0.route = .next(operationId: operationId, flowMode: $0.flowMode)
        }

    case .requiresSwitchToNoLimit:
        update {
            $0.actionPhase = .idle
            $0.modal = ModalState(kind: .switchToNoLimit)
        }

    case .failure:
        update {
            $0.actionPhase = .idle
            $0.modal = ModalState(kind: .genericError)
        }
    }
}


⸻

🪟 11️⃣ Modal actions

func modalPrimaryAction() {

    guard let modal = state.modal else { return }

    switch modal.kind {

    case .switchToNoLimit:
        update {
            $0.flowMode = .noLimit
            $0.modal = nil
        }

    case .genericError:
        update { $0.modal = nil }
    }
}

func modalSecondaryAction() {

    guard let modal = state.modal else { return }

    switch modal.kind {

    case .switchToNoLimit:
        update {
            $0.modal = nil
            $0.route = .goHome
        }

    case .genericError:
        update { $0.modal = nil }
    }
}



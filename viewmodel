📥 7️⃣ Load Flow

extension CardUpgradeViewModel {

    func onAppear() {
        guard state.phase == .idle else { return }

        loadTask?.cancel()

        loadTask = Task {
            update { $0.phase = .loading }

            do {
                let snapshot = try await loadUseCase.execute(request: [:])

                update {
                    $0.snapshot = snapshot
                    $0.phase = .loaded
                    $0.selectedCardId = snapshot.details.offered.first?.id
                    $0.flowMode = .withLimit
                }

            } catch {
                update { $0.phase = .failed }
            }
        }
    }
}



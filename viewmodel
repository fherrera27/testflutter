🧠 6️⃣ Helper update (transaccional)

Evita múltiples renders.

private extension CardUpgradeViewModel {

    func update(_ mutate: (inout CardUpgradeScreenState) -> Void) {
        var next = state
        mutate(&next)
        state = next
        viewData = presenter.build(from: state)
    }
}


